# API
REACT_APP_API_BASE_URL=https://your-api.execute-api.region.amazonaws.com

# AWS Cognito – therapist pool (dashboard login)
REACT_APP_COGNITO_HOSTED_UI_DOMAIN=https://your-prefix.auth.us-east-1.amazoncognito.com
REACT_APP_COGNITO_CLIENT_ID=your-therapist-app-client-id

# AWS Cognito – client pool (client portal login, separate user pool)
# Get domain from Cognito → User pool us-east-1_t94dX44xN → App integration → Domain name
REACT_APP_COGNITO_CLIENT_HOSTED_UI_DOMAIN=https://your-client-prefix.auth.us-east-1.amazoncognito.com
REACT_APP_COGNITO_CLIENT_CLIENT_ID=your-client-app-client-id

# Optional: defaults to current origin + /auth/callback
# REACT_APP_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback

# Azure AD / MSAL (optional, for Microsoft sign-in)
REACT_APP_AAD_CLIENT_ID=
REACT_APP_AAD_AUTHORITY=https://login.microsoftonline.com/common
REACT_APP_AAD_REDIRECT_URI=http://localhost:3000
